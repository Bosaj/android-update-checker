<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- Settings only (thresholds, reminder choice, ignored apps), and only when the backup is end-to-end encrypted. -->
    <cloud-backup disableIfNoEncryptionCapabilities="true">
        <include domain="file" path="datastore/" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="datastore/" />
    </device-transfer>
</data-extraction-rules>
